# Copy this file to backend/.env and fill in real values. Never commit .env.

# development | production
# In production every required value below must be set or the app refuses to start.
APP_ENV=development

# Signs login tokens. Required in production (min 32 random characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty locally to use the bundled SQLite file (backend/campusone.db).
# Production example: postgresql://user:password@host:5432/campusone
DATABASE_URL=

# Comma-separated list of allowed frontend origins. Required in production.
# Local default when empty: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Optional. Enables LLM phrasing in the assistant and AI document checks.
# Every feature still works without it, using the deterministic engine.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Where uploaded OD documents are kept: local (filesystem) or database.
STORAGE_BACKEND=local
STORAGE_DIR=
MAX_UPLOAD_MB=5

# Development only: seed demo data when the database is completely empty.
AUTO_SEED=true
