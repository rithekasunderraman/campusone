# Copy this file to backend/.env and fill in real values. Never commit .env.

# development | production
# In production every required value below must be set or the app refuses to start.
APP_ENV=development

# Signs login tokens. Required in production (min 32 random characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty locally to use the bundled SQLite file (backend/campusone.db).
# Production example: postgresql://user:password@host:5432/campusone
DATABASE_URL=

# Comma-separated list of allowed frontend origins. Required in production.
# Local default when empty: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Optional LLM features (assistant phrasing, best-effort answers, AI document reading).
# Every feature still works without a key, using the deterministic engine.
# Choose the provider, then fill in that provider's key. Switching is this one setting.
#   anthropic -> ANTHROPIC_API_KEY (+ LLM_MODEL)
#   gemini    -> GEMINI_API_KEY    (+ GEMINI_MODEL)   free keys: https://aistudio.google.com/apikey
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

GEMINI_API_KEY=
# One model, or several separated by commas (tried in order if one is overloaded).
# Empty = gemini-2.5-flash,gemini-3.5-flash,gemini-flash-lite-latest
GEMINI_MODEL=

# Where uploaded OD documents are kept: local (filesystem) or database.
STORAGE_BACKEND=local
STORAGE_DIR=
MAX_UPLOAD_MB=5

# Development only: seed demo data when the database is completely empty.
AUTO_SEED=true
